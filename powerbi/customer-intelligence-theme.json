{
  "name": "Customer Intelligence",
  "dataColors": [
    "#2A78D6",
    "#EB6834",
    "#1BAF7A",
    "#EDA100",
    "#E87BA4",
    "#008300",
    "#4A3AA7",
    "#E34948"
  ],
  "background": "#F9F9F7",
  "foreground": "#0B0B0B",
  "tableAccent": "#2A78D6",
  "good": "#0CA30C",
  "neutral": "#FAB219",
  "bad": "#D03B3B",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#0B0B0B"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#52514E"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 28,
      "color": "#0B0B0B"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 10,
      "color": "#898781"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FCFCFB" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E1E0D9" } },
            "radius": 4
          }
        ],
        "dropShadow": [{ "show": false }],
        "visualHeader": [{ "show": false }],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#0B0B0B" } },
            "background": { "solid": { "color": "#FCFCFB" } },
            "alignment": "left",
            "fontSize": 12
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#F9F9F7" } },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": { "solid": { "color": "#F9F9F7" } }
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "fontColor": { "solid": { "color": "#52514E" } },
            "fontSize": 10
          }
        ],
        "valueAxis": [
          {
            "show": false,
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "labels": [
          {
            "show": true,
            "color": { "solid": { "color": "#52514E" } },
            "fontSize": 10
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "fontColor": { "solid": { "color": "#52514E" } },
            "fontSize": 10
          }
        ],
        "valueAxis": [
          {
            "show": false,
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "labels": [
          {
            "show": true,
            "color": { "solid": { "color": "#52514E" } },
            "fontSize": 10
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#E1E0D9" } },
            "gridHorizontalWeight": 1,
            "rowPadding": 6,
            "outlineColor": { "solid": { "color": "#E1E0D9" } },
            "outlineWeight": 0
          }
        ],
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#898781" } },
            "backColor": { "solid": { "color": "#FCFCFB" } },
            "fontSize": 9,
            "bold": true,
            "outline": "BottomOnly"
          }
        ],
        "values": [
          {
            "fontColor": { "solid": { "color": "#0B0B0B" } },
            "backColor": { "solid": { "color": "#FCFCFB" } },
            "fontSize": 10,
            "outline": "None"
          }
        ],
        "total": [
          {
            "totals": false
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#0B0B0B" } },
            "fontSize": 28,
            "fontFamily": "Segoe UI Semibold",
            "labelDisplayUnits": 1
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#898781" } },
            "fontSize": 10
          }
        ]
      }
    }
  }
}
